# ============================================================
#  ESME COOKIES - Plantilla de variables de entorno
#  Copiá este archivo a ".env" y completá los valores.
#  El archivo .env NUNCA se sube al repo (está en .gitignore).
# ============================================================

# --- Base de datos ---
# Por defecto usa un archivo local (sistema independiente, sin nube):
DATABASE_URL=file:data/esme.db
# Para usar una base remota (opcional), poné aquí la URL y el token:
# DATABASE_URL=libsql://tu-base.turso.io
# DATABASE_AUTH_TOKEN=tu-token

# --- Seguridad (JWT) ---
# CRÍTICO en producción: definí un valor fijo y secreto. Generalo con:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

# --- Admin por defecto (se crea la 1ra vez si no hay admins) ---
ADMIN_USER=admin
ADMIN_PASS=cambia-esta-clave

# --- Servidor ---
PORT=3001
NODE_ENV=development
APP_URL=http://localhost:3001

# --- Cloudinary (opcional, para subir imágenes de productos) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
