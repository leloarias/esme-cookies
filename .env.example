# ============================================================
#  ESME COOKIES - Plantilla de variables de entorno
#  Copiá este archivo a ".env" y completá los valores.
#  El archivo .env NUNCA se sube al repo (está en .gitignore).
# ============================================================

# --- Base de datos ---
# Por defecto usa un archivo local (sistema independiente, sin nube):
DATABASE_URL=file:data/esme.db
# Para usar una base remota (opcional), poné aquí la URL y el token:
# DATABASE_URL=libsql://tu-base.turso.io
# DATABASE_AUTH_TOKEN=tu-token

# --- Seguridad (JWT) ---
# CRÍTICO en producción: definí un valor fijo y secreto. Generalo con:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

# --- Admin por defecto (se crea la 1ra vez si no hay admins) ---
ADMIN_USER=admin
# Si dejás ADMIN_PASS vacío, el servidor genera una contraseña al azar y la
# imprime UNA sola vez en el log al arrancar (buscá "Contraseña generada").
# Si preferís elegirla vos, escribila acá.
ADMIN_PASS=

# --- Servidor ---
PORT=3001
NODE_ENV=production
# Dominio o URL pública por la que se accede (el link del túnel, mientras no
# haya dominio propio). Se usa en los links de los emails/WhatsApp.
APP_URL=http://localhost:3001

# --- Cloudinary (opcional, para subir imágenes de productos) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
