# ============================================================
#  ESME COOKIES - Plantilla de variables de entorno
#  Copiá este archivo a ".env" y completá los valores reales.
#  El archivo .env NUNCA se sube al repo (está en .gitignore).
# ============================================================

# --- Base de datos Turso (libsql en la nube) ---
TURSO_DATABASE_URL=libsql://esme-cookies-tu-org.turso.io
TURSO_AUTH_TOKEN=tu-token-de-turso

# --- Seguridad (JWT) ---
# CRÍTICO: definí un valor fijo y secreto. Si queda vacío en producción,
# las sesiones de admin se invalidan en cada reinicio del servidor.
# Generá uno con:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

# --- Admin por defecto (solo se usa la 1ra vez, si la BD no tiene admins) ---
ADMIN_USER=admin
ADMIN_PASS=cambia-esta-clave

# --- Servidor ---
PORT=3001
NODE_ENV=production
# URL pública de la app (para los links del panel en los emails)
APP_URL=http://localhost:3001

# --- Cloudinary (imágenes de productos) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
